# Stark-Host settings — KEEP THIS FILE SECRET (do not share / upload it anywhere)

# ===== ADMIN LOGIN =====
ADMIN_USER=admin
ADMIN_PASS=change-me

# ===== Your domain =====
# Panel / website domain (gets automatic HTTPS), e.g. stark-host.com  (A record -> server IP)
PANEL_DOMAIN=junaidnizaa.top
# Optional wildcard domain for user apps, e.g. starkapps.net  (*.starkapps.net -> server IP)
# Empty = free <name>.<server-ip>.sslip.io domains
BASE_DOMAIN=
PUBLIC_IP=

# ===== Built-in databases (start with: docker compose --profile dbs up -d) =====
MONGO_ROOT_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ===== Email (SMTP) — first-run defaults; later you edit them in Admin -> Settings =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=change-me
SMTP_FROM=you@gmail.com

# ===== Keep accounts forever (MongoDB) =====
# Accounts, projects, plans, keys, payments and settings are saved in this MongoDB, so updates never delete them.
# Paste your MongoDB Atlas URI here (mongodb+srv://USER:<db_password>@cluster.../). Leave empty to use ADMIN_DB_MONGO below.
MONGO_URI=
MONGO_URI_PASSWORD=

# ===== Your own cloud databases — added to the ADMIN account (Databases page) =====
# MongoDB Atlas: replace <db_password> with the real password of the Atlas user "Kamran"
ADMIN_DB_MONGO=
# Atlas password for user Kamran goes here (no need to edit the URL above)
ADMIN_DB_MONGO_PASSWORD=
ADMIN_DB_POSTGRES=
ADMIN_DB_MYSQL=

# ===== Payments: Cryptomus (or enter them in Admin -> Settings) =====
CRYPTOMUS_MERCHANT=
CRYPTOMUS_KEY=

