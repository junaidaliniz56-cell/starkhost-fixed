# Automatic HTTPS for generated domains AND custom domains (on-demand TLS).
# A certificate is only issued if the panel says the domain belongs to a project.
{
	on_demand_tls {
		ask http://panel:8085/internal/ask
	}
}

:80 {
	reverse_proxy panel:8085
}

:443 {
	tls {
		on_demand
	}
	reverse_proxy panel:8085
}
